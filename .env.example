# Environment Configuration Template for PetFlow SaaS
# Para SQLite local: "file:./dev.db"
# Para PostgreSQL de produção: "postgresql://petflow_user:petflow_secret@localhost:5432/petflow?schema=public"
DATABASE_URL="file:./dev.db"

# Chave secreta de sessão / JWT
JWT_SECRET="insira_uma_chave_secreta_longa_e_aleatoria_com_mais_de_32_caracteres"

# URL base da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Ambiente (development, test, production)
NODE_ENV="development"
